# Copy to docker/.env and edit the two paths (Linux/WSL2 syntax; quote paths with spaces).
# Windows drive D:\UAV\A.tortilis_Data & Model  ->  /mnt/d/UAV/A.tortilis_Data & Model
DATA_DIR="/mnt/d/A.tortilis_Data & Model/Data used to build the model"
WEIGHTS_DIR="/mnt/d/A.tortilis_Data & Model/A.tortilis Models/Pretrained weights"
# optional: where training outputs go (default ../work_dirs) and the inference scratch space
#WORK_DIRS=/mnt/d/umv_work_dirs
#SCRATCH_DIR=/mnt/d/umv_scratch
HF_HUB_OFFLINE=0
